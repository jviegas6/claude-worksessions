# claude-worksessions configuration
#
# Copy to <work root>/_config/config.env (recommended: it then travels with your
# synced work folder) or ~/.config/claude-worksessions/config.env, and edit.
# Plain KEY="value" lines; $HOME is expanded. Read by the zsh functions, the
# Python tools and install.sh. Never put tokens or passwords in here.

# --- Where the work lives -------------------------------------------------------
# Every request gets a folder under here: YYYY/MM/DD/HH-mm-ss_slug
CWS_WORK_ROOT="$HOME/Library/CloudStorage/OneDrive-Contoso/work_sessions"

# --- Who you are (used in the skills' wording and matching) --------------------
CWS_ORG="Contoso"
CWS_USER_ROLE="data/platform engineer"
# IANA zone, plus the Windows name Outlook uses for it in calendar results
CWS_TIMEZONE="Europe/London"
CWS_TIMEZONE_WINDOWS="GMT Standard Time"

# --- Weekly report email (claude-audit --report) ----------------------------------
# Subject is "Weekly Report - <CWS_USER_NAME>"; the window is the seven days before
# CWS_REPORT_DAY (Wed: Wednesday to Tuesday); To and Due are shown with the draft.
CWS_USER_NAME="First Last"
CWS_REPORT_TO="manager@contoso.com"
CWS_REPORT_DAY="Wed"
CWS_REPORT_DUE="18:00 CET"
# Friday emails (claude-audit --friday): weeks of evidence for an architect phase, and the
# ADR register (a Markdown table with a Status column); empty = _config/adr-register.md
CWS_ARCH_LOOKBACK_WEEKS="4"
CWS_ADR_REGISTER=""

# --- Tickets --------------------------------------------------------------------
# Shown in prompts and help text. Any PREFIX-123 is accepted, or "Other".
CWS_TICKET_EXAMPLE="PROJ-123"
# Atlassian cloud id for the weekly review's Jira query (leave empty if no Jira).
# Find it with the Atlassian MCP: getAccessibleAtlassianResources
CWS_JIRA_CLOUD_ID=""

# --- T3 Code sidebar groups -------------------------------------------------------
# Big projects each get a heading; anything else is ad-hoc, with a heading per type. The last
# type is the fallback. Empty CWS_TYPES: no grouping. See claude-area.
CWS_PROJECTS=""
CWS_TYPES=""

# --- Task types -----------------------------------------------------------------
# What kind of work a session is. claude-new suggests from the types you have already
# used, then from this seed list; you can always type a new one.
CWS_TASK_TYPES="permissions, job errors, new features, security, investigation, data quality, tooling, documentation"

# --- Claude config dirs ---------------------------------------------------------
# Where Claude keeps each login's sessions: ~/.claude, or one dir per login an app such as T3
# runs (Settings > Providers). claude-audit and claude-search read the transcripts of all of
# them; which one a session uses is the app's choice. Space-separated; ~ and $HOME expand.
CWS_CLAUDE_HOMES="~/.claude-personal ~/.claude-work"

# --- How claude-new opens a request -------------------------------------------
# One command each; {dir} {title} {prompt} {project} {type} are filled in, shell-quoted.
# CWS_OPEN_CMD opens the new folder; empty = claude-new just prints its path. Other apps:
#   code {dir}                          VS Code
#   open -a Terminal {dir}              a Terminal window (macOS)
CWS_OPEN_CMD="claude-t3-sync --open {dir} --prompt {prompt}"
# CWS_AFTER_NEW_CMD runs first, once the folder exists: T3's sidebar grouping. Empty = nothing.
CWS_AFTER_NEW_CMD="claude-area --dir {dir} --pick {project} --type {type}"
# T3 Code's command; empty = t3 on PATH, else ~/.t3/bin/t3 (the desktop app writes it)
CWS_T3_BIN=""
# The provider instance and model of a thread claude-t3-sync starts in a project with no default
# model (every project it adds). Both empty = those of the thread you used last in T3.
CWS_T3_PROVIDER=""
CWS_T3_MODEL=""
# claude-t3-sync removes an empty T3 project after this many idle days
CWS_T3_IDLE_DAYS="14"

# --- Optional extras ------------------------------------------------------------
# yazi file browser + glow Markdown preview + Markdown -> HTML for email
CWS_INSTALL_YAZI="1"

# --- Session contract and hooks (both off by default) ------------------------------
# claude-new asks "Goal" and "Done when" for every new request (else the name is the goal)
CWS_ASK_GOAL="0"
# The prompt-quality hooks (vague request / does not exist -> ask first) and claude-guard,
# written into every CWS_CLAUDE_HOMES dir's settings.json by install.sh when on; taken out when off
CWS_HOOKS="0"

# --- claude-guard: keep sessions on their request (needs CWS_HOOKS="1") -----------
# off | shadow (decide and log to .quality.jsonl, never block)
#     | warn (as shadow, plus a one-line notice where enforce would act) | enforce (block)
CWS_GUARD_MODE="off"
# Model for the judge that tells continuation from pivot, and how long to wait for it
CWS_GUARD_MODEL="haiku"
CWS_GUARD_JUDGE_TIMEOUT="25"
# How many times a session's goal can be widened before the next widening is a new objective
CWS_GUARD_MAX_EXTENSIONS="2"
# Claude config dir the judge runs with (e.g. ~/.claude-work); empty = the session's own
CWS_GUARD_CONFIG_DIR=""
# First parts of dotted names that are code, not data, in your tools' commands
# (e.g. SDK objects), space-separated
CWS_GUARD_IGNORE_NAMES=""
