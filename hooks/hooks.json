{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook-vague\"", "timeout": 10 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-guard\" prompt", "timeout": 30 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Glob|Grep|WebFetch|WebSearch|Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-guard\" tool", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook-notfound\"", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|mcp__.*",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook-notfound\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-guard\" stop", "timeout": 20 } ] }
    ]
  }
}
