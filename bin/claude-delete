#!/usr/bin/env python3
"""claude-delete: move a Claude session with no lasting value to the deleted-sessions bin.

  claude-delete ID              say what goes, ask, then move it to the bin
  claude-delete ID --yes        without asking
  claude-delete ID --check      only say whether it may go and what that would mean
  claude-delete ID --json       the same, as JSON (for the VS Code sidebar)
  claude-delete --list [--json] what is in the bin
  claude-delete --restore ID    put a deleted session back where it was
  claude-delete --purge ID      delete it for good (asks; --yes to not ask)
  claude-delete --empty         delete everything in the bin for good (asks; --yes)

ID is a session id, or the start of one (8 characters are usually enough).

Only a session with no value may go: one with no artifacts (none of the files it wrote
still exist, and if it is its request's only session, the request folder is empty), or one
kept out of the review with -n. Never one the weekly review booked, one a Claude process has
open, or one written in the last two minutes.

Its transcript and what Claude Code keeps beside it (subagent logs, file history, session
environment) move to the bin -- ~/.local/share/claude-worksessions/trash, one folder per
session with a record of where each piece came from -- and so does its request folder when
the session was its only one and nothing but .session.json is in it. Files the session wrote
are never touched. A pin on it is removed. --restore puts every piece back.
"""

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import time
import uuid

HOME = os.path.expanduser("~")


def load_sessions():
    """claude-sessions, which knows every session and whether it may be deleted."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "claude-sessions")
    if not os.path.isfile(path):
        path = os.path.join(HOME, ".local", "bin", "claude-sessions")
    loader = importlib.machinery.SourceFileLoader("claude_sessions", path)
    spec = importlib.util.spec_from_loader("claude_sessions", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


CS = load_sessions()
CA = CS.CA


def find(prefix):
    """The session whose id starts with prefix: (entry, every entry)."""
    entries = CS.as_json(CS.sessions())["sessions"]
    hits = [e for e in entries if e["id"].startswith(prefix)]
    if not prefix or not hits:
        raise SystemExit("claude-delete: no session {!r}".format(prefix))
    if len(hits) > 1:
        raise SystemExit("claude-delete: {!r} matches {} sessions -- give more of the id".format(prefix, len(hits)))
    return hits[0], entries


def leftovers(sid):
    """Everything Claude Code keeps for a session: its transcripts (a moved folder can leave a
    copy under the old path), their subagent folders, file history and session environment."""
    out, seen = [], set()
    for cfg in CA.CONFIG_DIRS:
        projects = os.path.join(cfg, "projects")
        for d in _listdir(projects):
            out += [os.path.join(projects, d, sid + ".jsonl"), os.path.join(projects, d, sid)]
        out += [os.path.join(cfg, "file-history", sid), os.path.join(cfg, "session-env", sid)]
    result = []
    for p in out:
        if os.path.lexists(p):
            real = os.path.realpath(p)
            if real not in seen:
                seen.add(real)
                result.append(real)
    return result


def _listdir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def empty_request(entry, entries):
    """The request folder, if this session is its only one and nothing but hidden files
    (.session.json) is in it; else None."""
    r = entry["request"]
    if not r or r["files"] or sum(1 for e in entries if e["request"] and e["request"]["path"] == r["path"]) > 1:
        return None
    root = CA.DEFAULT_ROOT
    if r["path"] == root or not r["path"].startswith(root + os.sep):
        return None
    return r["path"]


def when(ts):
    return dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M") if ts else "?"


def label(entry):
    return entry["title"] or entry["first_prompt"] or entry["last_prompt"] or "(empty session)"


def impact(entry, entries):
    """What deleting it means, one line each, for the confirmation."""
    lines = ["The conversation goes: it can no longer be resumed, and claude-search won't find it."]
    if entry["audited"]:
        lines.append("It counts in your review today: its time leaves claude-audit, the weekly review "
                     "and the daily recap.")
    else:
        lines.append("It is already kept out of the review (-n), so no time records change.")
    if entry["artifacts"]:
        shown = [os.path.relpath(f, entry["request"]["path"]) if entry["request"] and
                 f.startswith(entry["request"]["path"] + os.sep) else f.replace(HOME, "~")
                 for f in entry["artifacts"]]
        lines.append("{} file(s) it produced stay where they are, no longer linked to any session: {}{}".format(
            len(shown), ", ".join(shown[:6]), " and {} more".format(len(shown) - 6) if len(shown) > 6 else ""))
    else:
        lines.append("It left no files, so nothing else is lost.")
    folder = empty_request(entry, entries)
    if folder:
        lines.append("Its request folder {} is left empty, so it goes too.".format(
            os.path.relpath(folder, CA.DEFAULT_ROOT)))
    lines.append("It goes to the deleted-sessions bin, where it can be restored until you purge it.")
    return lines


def bin_dir():
    """The deleted-sessions bin: CWS_TRASH_DIR, else $XDG_DATA_HOME (or ~/.local/share)
    /claude-worksessions/trash. Local, like the transcripts -- never the synced work root."""
    return os.environ.get("CWS_TRASH_DIR") or os.path.join(
        os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "claude-worksessions", "trash")


def put_in_bin(entry, paths):
    """Move paths into a new bin folder with a manifest of where each came from."""
    folder = os.path.join(bin_dir(), "{}_{}".format(time.strftime("%Y%m%d-%H%M%S"), entry["id"][:8]))
    while os.path.exists(folder):
        folder += "-" + uuid.uuid4().hex[:4]
    items_dir = os.path.join(folder, "items")
    os.makedirs(items_dir)
    items = []
    for i, p in enumerate(paths):
        name = "{}_{}".format(i, os.path.basename(p.rstrip(os.sep)))
        shutil.move(p, os.path.join(items_dir, name))
        items.append({"from": p, "name": name})
    r = entry["request"]
    manifest = {"id": entry["id"], "title": label(entry), "request": r and r["name"],
                "request_path": r and r["path"], "ticket": r and r["ticket"],
                "last_activity": entry["mtime"], "deleted_at": time.time(), "items": items}
    with open(os.path.join(folder, "manifest.json"), "w") as fh:
        json.dump(manifest, fh, indent=2)
    return folder


def deleted():
    """What is in the bin, newest first: manifests, each with its bin folder as "dir"."""
    out = []
    for name in _listdir(bin_dir()):
        try:
            with open(os.path.join(bin_dir(), name, "manifest.json")) as fh:
                m = json.load(fh)
        except (OSError, ValueError):
            continue
        if isinstance(m, dict) and m.get("id"):
            out.append(dict(m, dir=os.path.join(bin_dir(), name)))
    return sorted(out, key=lambda m: m.get("deleted_at") or 0, reverse=True)


def find_deleted(prefix):
    hits = [m for m in deleted() if prefix and m["id"].startswith(prefix)]
    if not hits:
        raise SystemExit("claude-delete: no deleted session {!r} (see claude-delete --list)".format(prefix))
    if len(hits) > 1:
        raise SystemExit("claude-delete: {!r} matches {} deleted sessions -- give more of the id".format(prefix, len(hits)))
    return hits[0]


def restore(m):
    """Put every piece back where it came from. Nothing moves if any place is taken."""
    taken = [it["from"] for it in m["items"] if os.path.lexists(it["from"])]
    if taken:
        raise SystemExit("claude-delete: can't restore, already there: " + ", ".join(taken))
    for it in m["items"]:
        os.makedirs(os.path.dirname(it["from"]), exist_ok=True)
        shutil.move(os.path.join(m["dir"], "items", it["name"]), it["from"])
    shutil.rmtree(m["dir"])


def purge(m):
    shutil.rmtree(m["dir"])


def unpin(sid):
    p = os.path.join(CA.DEFAULT_ROOT, "_config", "pinned.json")
    try:
        with open(p) as fh:
            pins = json.load(fh)
        if sid not in (pins.get("sessions") or {}):
            return False
        del pins["sessions"][sid]
    except (OSError, ValueError, AttributeError, TypeError):
        return False
    with open(p, "w") as fh:
        json.dump(pins, fh, indent=2)
        fh.write("\n")
    return True


def delete(entry, entries):
    """Move the session (and its emptied request folder) to the bin. Returns the bin folder."""
    paths = leftovers(entry["id"])
    folder = empty_request(entry, entries)
    if folder and os.path.isdir(folder):
        paths.append(folder)
    where = put_in_bin(entry, paths)
    unpin(entry["id"])
    return where


def confirm(question, yes):
    if yes:
        return True
    if not sys.stdin.isatty():
        print("Not done: run with --yes to confirm without a terminal.")
        return False
    return input(question + " [y/N]: ").strip().lower() in ("y", "yes")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="claude-delete", description=__doc__.split("\n\n")[0].split(": ", 1)[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("id", nargs="?", help="the session id, or its start")
    ap.add_argument("--yes", "-y", action="store_true", help="don't ask")
    ap.add_argument("--check", action="store_true", help="only say whether it may go, and what that would mean")
    ap.add_argument("--json", action="store_true", help="--check or --list, as JSON")
    what = ap.add_mutually_exclusive_group()
    what.add_argument("--list", action="store_true", help="what is in the bin")
    what.add_argument("--restore", metavar="ID", help="put a deleted session back")
    what.add_argument("--purge", metavar="ID", help="delete a deleted session for good")
    what.add_argument("--empty", action="store_true", help="delete everything in the bin for good")
    args = ap.parse_args(argv)

    if args.list:
        items = deleted()
        if args.json:
            print(json.dumps(items, indent=1))
        for m in [] if args.json else items:
            print("{}  {}  ({}, deleted {})".format(m["id"][:8], m.get("title") or "?",
                                                    m.get("request") or "the work root", when(m.get("deleted_at"))))
        if not args.json:
            print("{} deleted session(s) in {}".format(len(items), bin_dir()))
        return 0
    if args.restore:
        m = find_deleted(args.restore)
        restore(m)
        print("Restored {}  {} ({} item(s) put back).".format(m["id"][:8], m.get("title") or "?", len(m["items"])))
        return 0
    if args.purge or args.empty:
        targets = [find_deleted(args.purge)] if args.purge else deleted()
        if not targets:
            print("The bin is empty.")
            return 0
        names = ", ".join((m.get("title") or m["id"][:8]) for m in targets[:5]) + (" …" if len(targets) > 5 else "")
        if not confirm("Delete {} session(s) for good ({})? This can't be undone.".format(len(targets), names), args.yes):
            print("Not deleted.")
            return 1
        for m in targets:
            purge(m)
        print("Deleted for good: {} session(s).".format(len(targets)))
        return 0
    if not args.id:
        ap.error("give a session id, or --list / --restore / --purge / --empty")

    entry, entries = find(args.id)
    verdict = entry["deletable"]
    lines = impact(entry, entries)
    if args.json:
        print(json.dumps({"id": entry["id"], "title": label(entry), "last_activity": when(entry["mtime"]),
                          "request": entry["request"] and entry["request"]["name"],
                          "deletable": verdict["ok"], "why": verdict["why"], "blocked": verdict["blocked"],
                          "impact": lines, "folder": empty_request(entry, entries)}, indent=1))
        return 0 if verdict["ok"] else 1

    where = entry["request"]["name"] if entry["request"] else "the work root"
    print("{}  {}  ({}, last active {})".format(entry["id"][:8], label(entry), where, when(entry["mtime"])))
    if not verdict["ok"]:
        print("Can't delete it: " + "; ".join(verdict["blocked"]) + ".")
        return 1
    print("It may go: " + " and ".join(verdict["why"]) + ".")
    for ln in lines:
        print("  - " + ln)
    if args.check:
        return 0
    if not confirm("Move it to the deleted-sessions bin?", args.yes):
        print("Not deleted.")
        return 1
    delete(entry, entries)
    print("Moved to the bin. Undo: claude-delete --restore {}".format(entry["id"][:8]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
