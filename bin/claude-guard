#!/usr/bin/env python3
"""claude-guard: keeps a session on the request it was given. Claude Code hooks, registered
by install.sh in each profile's settings.json, plus a report for reviewing what they saw.

    claude-guard prompt     UserPromptSubmit: is this prompt a continuation of the session's
                            goal, a wider version of it, or a new objective (pivot)?
                            Writes the request's contract -- literal scope and targets -- to
                            .scope.json in the session folder
    claude-guard tool       PreToolUse (reads, web, Bash, MCP): does the call stay on the
                            contract's targets, and is it not the same call again and again?
    claude-guard stop       Stop: after an investigation, does the answer end by proposing
                            the next level instead of having done it?
    claude-guard report [--days N] [PATH]
                            what the guard saw, from every .quality.jsonl under the work root
    claude-guard review [--days N] [--all]  |  review ID right|wrong [NOTE]
                            go through the judge's decisions and mark them, to tune the rules

Every judge decision -- what it saw and what it said -- is also kept in
<work root>/_audit/guard/judge.jsonl; your review marks go to reviews.jsonl next to it.
CWS_GUARD_PROFILE picks the profile the judge runs under (default: the session's own).

The rules are plain and deterministic; only the prompt check asks a judge -- a separate,
clean `claude -p` on a small model that sees the goal, the current scope and the new prompt,
never the session. Its criteria live in _config/guard-rules.md.

CWS_GUARD_MODE decides what happens: `off`, `shadow` (decide and log to .quality.jsonl,
never block; the judge runs in the background so prompts are not held up), `warn` (as shadow,
and show the user a one-line notice where enforce would act) or `enforce` (block pivots and
out-of-scope calls, ask once for next-level proposals). Extensions of the goal add up: past
CWS_GUARD_MAX_EXTENSIONS (2) in a session, one more counts as a new objective. Everything fails
open: an error or a slow judge lets the action through and is logged.

A prompt starting `force:` passes unchecked (logged as an override); one asking to go deeper
("aprofunda", "go deeper", ...) lifts the target check until the next request.
"""

import contextlib
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
MODES = ("off", "shadow", "warn", "enforce")
BACKGROUND = ("shadow", "warn")      # the judge runs detached: prompts are never held up
JUDGE_ENV = "CWS_GUARD_JUDGE"       # set in the judge's own claude -p, so its hooks stay quiet

FORCE = re.compile(r"^\s*force:\s*", re.I)
WIDEN = re.compile(r"\b(aprofund\w*|mais a fundo|mais fundo|explor[ae]\w*|go deeper|dig (deeper|into)|deep[- ]dive|"
                   r"in depth|explore|expand on)\b", re.I)
CONFIRM = re.compile(r"^\s*(yes|yep|y|no|ok|okay|sure|go|go ahead|do it|done|merged|thanks|thank you|continue|"
                     r"proceed|approved?|perfect|great|nice|cool|sim|não|nao|avança|segue|obrigad[oa]|faz|pode ser)\b",
                     re.I)
# What a tool call reaches: catalog.schema.table-like names, paths and URLs
DOTTED = re.compile(r"(?<![\w./-])([A-Za-z_][\w-]*\.[A-Za-z_][\w-]*\.[A-Za-z_][\w-]*)(?![\w-]|\.\w)")
# spaces only inside a folder name that another "/" follows: ~/Repos/BI Handover/x
PATH = re.compile(r"(?<![\w.:/~-])(~?/[\w.@~+-]+(?:/(?:[\w.@~+-]+(?: [\w.@~+-]+)+(?=/)|[\w.@~+-]+))*)")
# code, not data: os.path.join, self.client.get. Platform objects that show up in commands the
# same way go in CWS_GUARD_IGNORE_NAMES (space-separated first parts)
CODE_NAMES = {"os", "sys", "json", "re", "self", "dt", "datetime", "subprocess", "np", "pd", "math", "time",
              "pathlib", "shutil", "io", "cls", "super", "string", "collections", "typing", "importlib", "urllib",
              "itertools", "functools", "logging", "argparse", "tempfile", "hashlib", "glob", "fcntl", "contextlib",
              "textwrap", "unittest", "pytest", "types", "csv", "random", "uuid", "http", "email", "base64"}
# ./x and ../x in commands: resolved against the session's cwd
RELATIVE = re.compile(r"(?<![\w./~-])(\.\.?/[\w.@~+/-]*)")
# text that is a message, not something reached: heredoc bodies, and -m/--body/--title/--message values
HEREDOC = re.compile(r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?\n\s*\1\b", re.S)
MESSAGE_ARG = re.compile(r"(?:-m|--message|--body|--title|--notes|--description)[ =](\"(?:[^\"\\]|\\.)*\"|'[^']*')")
WRITE_TOOLS = {"Write": "file_path", "Edit": "file_path", "MultiEdit": "file_path", "NotebookEdit": "notebook_path"}
URL = re.compile(r"https?://[^\s'\"`<>)]+")
FILE_EXT = {"py", "md", "json", "jsonl", "txt", "csv", "yml", "yaml", "sh", "zsh", "log", "html", "gz", "sql",
            "toml", "ts", "js", "tsx", "ipynb", "env", "xml", "png", "pdf", "zip", "tar"}
TEMP_ROOTS = ("/tmp", "/private/tmp")      # scratch space, besides the system temp dir
REACH_TOOLS = re.compile(r"^(Read|Glob|Grep|WebFetch|WebSearch|Bash|mcp__.*)$")
WORDS = re.compile(r"[a-z0-9][a-z0-9._-]{2,}")
LOOP_AFTER = 3                      # the same call this many times in one request is a loop
INVESTIGATION = 3                   # reads in one request that make it an investigation (next steps expected)
VERDICT_WAIT = 15.0                 # warn: how long the end of an answer waits for its prompt's verdict
                                    # (under the Stop hook's 20 s timeout; the judge takes 5-12 s)
VERDICT_STALE = 30.0                # ... never for a judge started longer ago than this
BRIEF = re.compile(r"\b(just|only|one line|one-liner|briefly|in short|short answer|no explanation|"
                   r"s[oó]|apenas|numa linha|resumidamente)\b", re.I)
PROPOSALS = re.compile(r"(next (step|level)|could also|if you want|want me to|shall i|should i|would you like|"
                       r"deeper|próxim|posso |queres|quer que|se quiseres|aprofund|pr[oó]ximo passo)", re.I)

DEFAULT_RULES = """\
You judge whether a new user prompt continues a work session or starts a new objective.

- continuation: steps, clarifications, fixes, confirmations or follow-ups that are needed to
  reach the session goal / done-when, including narrowing it. Questions or remarks about the
  assistant's previous answer or how the work went ("why did you do that?", "so you assumed
  X?", "that's wrong") are continuations too: they are about the work in hand.
- extension: the same goal, applied wider within what it names: another table or schema in
  the same system, another environment of the same job, one more object of the same kind in
  the same product. The deliverable grows; the objective does not change.
- A different product, platform, system or technology is a pivot, even for the same kind of
  deliverable: goal "understand the Databricks API", prompt "what about Snowflake?" is a pivot.
- pivot: an outcome that is not needed to reach the goal, even when the topic is related.
  Example: goal "fix the access policy on table X", prompt "survey every access-control
  mechanism the platform offers" is a pivot: a broader survey, a different deliverable.

literal: one sentence with exactly what the prompt asks for, no more.
targets: the concrete things the request is about, as written (table, file, folder, job,
repo, service, dataset, URL). Empty when none are named.
"""
SCHEMA = {"type": "object", "required": ["verdict", "literal", "targets", "reason"], "properties": {
    "verdict": {"type": "string", "enum": ["continuation", "extension", "pivot"]},
    "literal": {"type": "string"}, "targets": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}}}


def load_config():
    """KEY="value" lines from $CWS_CONFIG or ~/.config/claude-worksessions/config.env;
    environment variables win."""
    path = os.environ.get("CWS_CONFIG") or os.path.join(HOME, ".config", "claude-worksessions", "config.env")
    conf = {}
    try:
        with open(path) as fh:
            for line in fh:
                m = re.match(r"\s*([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
                if not m:
                    continue
                val = m.group(2).strip()
                if val[:1] in ("'", '"'):
                    val = val[1:].split(val[0])[0]
                else:
                    val = val.split(" #")[0].strip()
                conf[m.group(1)] = val.replace("${HOME}", HOME).replace("$HOME", HOME)
    except OSError:
        pass
    conf.update({k: v for k, v in os.environ.items() if k.startswith("CWS_")})
    return conf


def settings(conf):
    mode = (conf.get("CWS_GUARD_MODE") or "off").strip().lower()
    try:
        timeout = float(conf.get("CWS_GUARD_JUDGE_TIMEOUT") or 25)
    except ValueError:
        timeout = 25.0
    root = conf.get("CWS_WORK_ROOT") or os.environ.get("CLAUDE_WORK_ROOT") or os.path.join(HOME, "work_sessions")
    ignore = CODE_NAMES | set((conf.get("CWS_GUARD_IGNORE_NAMES") or "").lower().split())
    try:
        max_ext = max(0, int(conf.get("CWS_GUARD_MAX_EXTENSIONS") or 2))
    except ValueError:
        max_ext = 2
    return {"mode": mode if mode in MODES else "off", "model": conf.get("CWS_GUARD_MODEL") or "haiku", "ignore": ignore,
            "timeout": timeout, "root": os.path.realpath(root), "profile": (conf.get("CWS_GUARD_PROFILE") or "").strip(),
            "max_ext": max_ext}


def now():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- the session folder: .session.json, .scope.json, .quality.jsonl ---------------------
def session_dir(cwd, root):
    """The request folder cwd is in (the nearest one with a .session.json, inside the work
    root), or None -- sessions outside a request folder are not guarded."""
    d = os.path.realpath(cwd or ".")
    while d == root or d.startswith(root + os.sep):
        if os.path.isfile(os.path.join(d, ".session.json")):
            return d
        if d == root:
            break
        d = os.path.dirname(d)
    return None


def read_json(path, default):
    try:
        with open(path) as fh:
            v = json.load(fh)
        return v if isinstance(v, type(default)) else default
    except (OSError, ValueError):
        return default


def session_goal(sdir):
    meta = read_json(os.path.join(sdir, ".session.json"), {})
    return (meta.get("goal") or meta.get("name") or "").strip(), (meta.get("done_when") or "").strip()


def declared_paths(sdir):
    """Folders the request declares as part of its scope (claude-new/claude-goal --path)."""
    meta = read_json(os.path.join(sdir, ".session.json"), {})
    paths = meta.get("paths") if isinstance(meta.get("paths"), list) else []
    return [os.path.realpath(os.path.expanduser(p)).lower() for p in paths if isinstance(p, str) and p.strip()]


def git_root(path):
    """The git repository a path is in (the nearest folder with a .git), or None."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    while d and d != os.path.dirname(d):
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return None


@contextlib.contextmanager
def scope(sdir, sid):
    """This session's state in .scope.json, locked for the read-modify-write; saved on exit.
    Several sessions can share a folder, so the file holds one entry per session id."""
    import fcntl
    path = os.path.join(sdir, ".scope.json")
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    with os.fdopen(fd, "r+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            data = json.loads(fh.read() or "{}")
        except ValueError:
            data = {}
        if not isinstance(data, dict):
            data = {}
        sessions = data.setdefault("sessions", {})
        state = sessions.setdefault(sid or "none", {})
        yield state
        fh.seek(0)
        fh.truncate()
        fh.write(json.dumps(data, indent=1, ensure_ascii=False) + "\n")


def log(sdir, record):
    try:
        with open(os.path.join(sdir, ".quality.jsonl"), "a") as fh:
            fh.write(json.dumps(dict({"ts": now()}, **record), ensure_ascii=False) + "\n")
    except OSError as e:
        print("claude-guard: can't write .quality.jsonl: {}".format(e), file=sys.stderr)


# --- what a prompt or tool call names ---------------------------------------------------
def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for v in value.values():
            yield from strings(v)
    elif isinstance(value, (list, tuple)):
        for v in value:
            yield from strings(v)


def anchors(text, ignore=CODE_NAMES):
    """The concrete things a text names: dotted names, paths and URLs, lowercased."""
    out = set()
    for u in URL.findall(text):
        out.add(u.rstrip(".,;").lower())
    text = URL.sub(" ", text)
    for m in DOTTED.findall(text):
        if m.rsplit(".", 1)[-1].lower() not in FILE_EXT and m.split(".", 1)[0].lower() not in ignore:
            out.add(m.lower())
    for p in PATH.findall(text):
        if len(p) > 2:
            out.add(os.path.expanduser(p).rstrip("/.,;:"))        # paths keep their case: git_root needs it
    return out


def prompt_anchors(text):
    """What a prompt names, more loosely than a tool call: also two-part names
    (db.schema) and snake_case words, since targets are better too many than too few."""
    out = {a.lower() for a in anchors(text)}
    rest = URL.sub(" ", text)
    out |= {m.lower() for m in re.findall(r"(?<![\w./-])[A-Za-z_]\w*\.[A-Za-z_]\w*(?![\w.-])", rest)
            if m.rsplit(".", 1)[-1].lower() not in FILE_EXT}
    parts = {p for a in out for p in re.split(r"[./]", a)}  # a bare first part (db) would cover everything in it
    out |= {m.lower() for m in re.findall(r"\b[A-Za-z]\w*_\w+\b", rest) if len(m) >= 5 and m.lower() not in parts}
    return out


def matches(ident, targets):
    """Loose on purpose: a call on db.schema.table is on target 'schema', a file under a
    target folder is on it, and a target named inside a URL counts."""
    ident = ident.lower()
    tail = ident.rstrip("/").rsplit("/", 1)[-1].rsplit(".", 1)[-1]
    for t in targets:
        if len(t) >= 3 and (t in ident or ident in t or (len(tail) >= 3 and tail == t.rsplit(".", 1)[-1])):
            return True
    return False


def safe_roots(sdir, payload):
    roots = [sdir, payload.get("cwd"), payload.get("scratchpad_dir"), tempfile.gettempdir(), *TEMP_ROOTS, "/dev",
             os.environ.get("CLAUDE_CONFIG_DIR"), os.path.join(HOME, ".claude")]
    roots += [os.path.join(HOME, n) for n in os.listdir(HOME) if n.startswith(".claude-")] if os.path.isdir(HOME) else []
    return [os.path.realpath(r).lower() for r in roots if r]


def safe(ident, roots):
    """A path in the session folder, the scratchpad, a temp dir or Claude's own config."""
    if not ident.startswith("/"):
        return False
    forms = {ident.lower(), os.path.realpath(ident).lower()}
    return any(f == r or f.startswith(r + "/") for f in forms for r in roots)


def resolve(p, cwd):
    """A path as the tool would see it: ~ expanded, relative ones against the session's cwd."""
    p = os.path.expanduser(p)
    if not os.path.isabs(p):
        p = os.path.join(cwd or ".", p)
    return os.path.normpath(p).rstrip("/")


def command_text(command):
    """A Bash command without the text it only carries: heredoc bodies and message arguments
    (a commit message or PR body can name anything)."""
    return MESSAGE_ARG.sub(" ", HEREDOC.sub(" ", command or ""))


def reached(tool, tool_input, ignore=CODE_NAMES, cwd=None):
    """What a tool call reaches, as identifiers to check against the targets."""
    if tool in ("Read", "Glob", "Grep"):
        p = tool_input.get("file_path") or tool_input.get("path") or ""
        return {resolve(p, cwd)} if p else set()
    if tool == "WebFetch":
        return {(tool_input.get("url") or "").lower()} - {""}
    if tool == "WebSearch":
        q = (tool_input.get("query") or "").strip().lower()
        return {"search: " + q} if q else set()
    if tool == "Bash":
        text = command_text(tool_input.get("command"))
        return anchors(text, ignore) | {resolve(p, cwd) for p in RELATIVE.findall(text) if p.strip("./")}
    return anchors("\n".join(strings(tool_input)), ignore)


def trivial(prompt):
    t = (prompt or "").strip()
    if not t or t.startswith(("/", "<", "[")):
        return True
    if WIDEN.search(t) or prompt_anchors(t):
        return False
    return bool(CONFIRM.match(t) and len(t.split()) <= 6) or (len(t.split()) < 3 and "?" not in t)


# --- the judge ----------------------------------------------------------------------------
def rules_text(root):
    try:
        with open(os.path.join(root, "_config", "guard-rules.md")) as fh:
            text = fh.read().strip()
        return text or DEFAULT_RULES
    except OSError:
        return DEFAULT_RULES


def judge_profile(cfg):
    """The profile the judge runs under, and its environment: CWS_GUARD_PROFILE when set, else
    the session's own (inherited CLAUDE_CONFIG_DIR). Returns (name, env, error)."""
    env = dict(os.environ, **{JUDGE_ENV: "1"})
    if cfg.get("profile"):
        d = os.path.join(HOME, ".claude-" + cfg["profile"])
        if not os.path.isdir(d):
            return cfg["profile"], env, "judge profile dir {} not found".format(d)
        env["CLAUDE_CONFIG_DIR"] = d
        return cfg["profile"], env, None
    name = os.path.basename(os.environ.get("CLAUDE_CONFIG_DIR") or "").replace(".claude-", "", 1)
    return name or "default", env, None


def judge(job, cfg):
    """Ask the judge about one prompt. Returns (answer dict or None, error or None, ms)."""
    profile, env, perr = judge_profile(cfg)
    if perr:
        return None, perr, 0
    first = not job.get("literal")
    msg = "GOAL: {}\nDONE_WHEN: {}\nCURRENT SCOPE: {}\nNEW PROMPT: {}\n{}".format(
        job.get("goal") or "(none)", job.get("done_when") or "(not stated)",
        job.get("literal") or "(none -- this is the first request)", job["prompt"][:4000],
        "This is the session's first request: it defines the scope, so the verdict is continuation." if first else "")
    # The profile's settings are loaded (a gateway profile keeps its URL and token there) with every
    # hook switched off, so the judge never runs the guard or any other hook
    cmd = ["claude", "-p", "--settings", json.dumps({"disableAllHooks": True}), "--strict-mcp-config", "--model", cfg["model"], "--tools", "",
           "--no-session-persistence", "--system-prompt", rules_text(cfg["root"]) + "\nAnswer only via the JSON schema.",
           "--output-format", "json", "--json-schema", json.dumps(SCHEMA), msg]
    t = time.time()
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=cfg["timeout"], cwd=tempfile.gettempdir(),
                           env=env)
        out = json.loads(r.stdout or "{}")
        ans = out.get("structured_output")
        if out.get("is_error") or not isinstance(ans, dict) or ans.get("verdict") not in SCHEMA["properties"]["verdict"]["enum"]:
            return None, (out.get("result") or r.stderr or "no answer").strip()[:200], int((time.time() - t) * 1000)
        if first:
            ans["verdict"] = "continuation"
        return ans, None, int((time.time() - t) * 1000)
    except subprocess.TimeoutExpired:
        return None, "timeout after {:g}s".format(cfg["timeout"]), int((time.time() - t) * 1000)
    except (OSError, ValueError) as e:
        return None, str(e)[:200], int((time.time() - t) * 1000)


def grow(st, names, widen):
    """Add a request's names to the session's targets, and open or close the target check."""
    st["targets"] = sorted(set(st.get("targets") or []) | {n.strip().lower() for n in names if n.strip()})
    st["open"] = widen


def apply_verdict(sdir, job, cfg, ans, err, ms):
    """Record the judge's answer: the scope grows with its targets (unless a pivot is being
    blocked), and the decision is logged. Returns the log record. In enforce the prompt's own
    names join the targets here too, once it is known not to be a blocked pivot."""
    enforce = cfg["mode"] == "enforce"
    rec = {"event": "prompt", "session_id": job["sid"], "prompt_no": job["no"], "initiated_by": "user",
           "mode": cfg["mode"], "judge_ms": ms, "prompt": job["prompt"][:200]}
    verdict = None if err else ans["verdict"]
    reason = "" if err else ans.get("reason", "")
    with scope(sdir, job["sid"]) as st:
        current = st.get("prompt_no") == job["no"]                     # not overtaken by a later prompt
        if (st.get("judging") or {}).get("no") == job["no"]:
            st.pop("judging")
        # drift: extensions add up. Past the allowance, one more is a new objective too
        widened = int(st.get("extensions") or 0)
        drift = verdict == "extension" and current and widened >= cfg["max_ext"]
        if drift:
            reason = "the goal has already been widened {} times; this widens it again: {}".format(widened, reason)
        pivot = verdict == "pivot" or drift
        blocked = pivot and enforce
        if current and not blocked and verdict == "extension":
            st["extensions"] = widened + 1
        if enforce and current and not blocked:
            grow(st, job.get("names") or [], job.get("widen", False))
        if not err and current and not blocked:
            st["literal"] = ans.get("literal") or st.get("literal") or job["prompt"][:300]
            grow(st, ans.get("targets") or [], st.get("open", False))
        if cfg["mode"] == "warn" and pivot and current:
            st.setdefault("notices", []).append(
                "claude-guard: \"{}\" looks like a new objective, not part of this session's goal ({}). Goal: {}. "
                "Consider claude-new for it, or claude-goal if the goal changed.".format(
                    job["prompt"][:80], reason[:200], job.get("goal") or "(none)"))
    rec["judge_id"] = decision_id(job)
    if err:
        rec.update(decision="allow", type="ok", reason="judge failed, let through: " + err, judge_error=True)
    else:
        rec.update(decision="block" if pivot else "allow", type="pivot" if pivot else "ok",
                   verdict=verdict, reason=reason[:400], literal=ans.get("literal", "")[:300],
                   targets=ans.get("targets") or [])
        if drift:
            rec["drift"] = widened + 1
    log(sdir, rec)
    journal(sdir, job, cfg, ans, err, ms, blocked)
    return rec


# --- the judge's journal: every decision, in the work root, for review and learning ---------
def journal_dir(root):
    return os.path.join(root, "_audit", "guard")


def decision_id(job):
    return hashlib.sha1("{}|{}|{}".format(job["sid"], job["no"], job["prompt"]).encode()).hexdigest()[:10]


def journal(sdir, job, cfg, ans, err, ms, blocked):
    """Append the full decision -- what the judge saw and what it said -- to
    _audit/guard/judge.jsonl, so decisions can be reviewed (claude-guard review) and the rules
    tuned from them."""
    entry = {"id": decision_id(job), "ts": now(), "folder": os.path.relpath(sdir, cfg["root"]),
             "session_id": job["sid"], "prompt_no": job["no"], "mode": cfg["mode"], "model": cfg["model"],
             "profile": judge_profile(cfg)[0], "judge_ms": ms, "goal": job.get("goal", ""),
             "done_when": job.get("done_when", ""), "scope_before": job.get("literal", ""),
             "prompt": job["prompt"][:4000], "enforced": blocked}
    if err:
        entry["error"] = err
    else:
        entry.update(verdict=ans["verdict"], literal=ans.get("literal", ""), targets=ans.get("targets") or [],
                     reason=ans.get("reason", ""))
    try:
        os.makedirs(journal_dir(cfg["root"]), exist_ok=True)
        with open(os.path.join(journal_dir(cfg["root"]), "judge.jsonl"), "a") as fh:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as e:
        print("claude-guard: can't write the judge journal: {}".format(e), file=sys.stderr)


def read_jsonl(path):
    try:
        with open(path) as fh:
            lines = fh.readlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict):
            out.append(r)
    return out


def reviews(root):
    """The latest review of each decision id: {id: {"label", "note", "ts"}}."""
    return {r["id"]: r for r in read_jsonl(os.path.join(journal_dir(root), "reviews.jsonl")) if r.get("id")}


def review(args, cfg, out):
    """claude-guard review [--days N] [--all]         list decisions to review (pivots and
                                                       failures not yet reviewed, by default)
       claude-guard review ID right|wrong [NOTE...]   record your verdict on one decision"""
    decisions = read_jsonl(os.path.join(journal_dir(cfg["root"]), "judge.jsonl"))
    done = reviews(cfg["root"])
    if args and args[0] not in ("--days", "--all"):
        if len(args) < 2 or args[1] not in ("right", "wrong"):
            out.write("usage: claude-guard review ID right|wrong [NOTE...]\n")
            return 1
        hits = sorted({d["id"] for d in decisions if d.get("id", "").startswith(args[0])})
        if len(hits) != 1:
            out.write("claude-guard review: {} decisions match '{}'\n".format(len(hits), args[0]))
            return 1
        rec = {"id": hits[0], "ts": now(), "label": args[1], "note": " ".join(args[2:])}
        os.makedirs(journal_dir(cfg["root"]), exist_ok=True)
        with open(os.path.join(journal_dir(cfg["root"]), "reviews.jsonl"), "a") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        out.write("recorded: {} is {}\n".format(hits[0], args[1]))
        return 0
    days, show_all = 14, "--all" in args
    if "--days" in args:
        days = int(args[args.index("--days") + 1])
    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    rows = [d for d in decisions if d.get("ts", "") >= since and d.get("id")
            and (show_all or (d["id"] not in done and (d.get("verdict") in ("pivot", "extension") or d.get("error"))))]
    out.write("claude-guard review: {} decision(s){}\n".format(len(rows), "" if show_all else " to review"))
    for d in rows:
        mark = done.get(d["id"], {}).get("label", "")
        out.write("\n  {}  {}  {}{}\n".format(d["id"], d["ts"][:16], d.get("verdict") or "failed",
                                                "  [" + mark + "]" if mark else ""))
        out.write("    goal:   {}\n    prompt: {}\n    why:    {}\n".format(
            d.get("goal", "")[:110], d.get("prompt", "").replace("\n", " ")[:110], (d.get("reason") or d.get("error") or "")[:160]))
    if rows:
        out.write("\n  record a verdict: claude-guard review ID right|wrong [note]\n")
    return 0


# --- the hooks ------------------------------------------------------------------------------
def on_prompt(payload, cfg):
    sdir = session_dir(payload.get("cwd"), cfg["root"])
    if not sdir:
        return None
    sid, prompt = payload.get("session_id") or "none", payload.get("prompt") or ""
    goal, done_when = session_goal(sdir)
    pending = notices(sdir, sid, cfg)              # warnings from the last request, not shown yet
    base = {"event": "prompt", "session_id": sid, "initiated_by": "user", "mode": cfg["mode"], "prompt": prompt[:200]}
    with scope(sdir, sid) as st:
        no = st["prompt_no"] = int(st.get("prompt_no") or 0) + 1
        base["prompt_no"] = no
        literal = st.get("literal") or ""
        if not trivial(prompt):                     # words that can name a repo: "claude-worksessions"
            st["words"] = sorted(set(st.get("words") or []) | set(WORDS.findall(prompt.lower())))[-400:]
        if FORCE.match(prompt):
            st.update(open=True, turn=new_turn(), literal=FORCE.sub("", prompt)[:300], prompt=prompt[:300])
            log(sdir, dict(base, decision="allow", type="ok", override=True, reason="force: prefix"))
            return show(pending, cfg)
        if trivial(prompt):                        # a confirmation or a command: same request goes on
            st["turn"] = new_turn()
            return show(pending, cfg)
        st["turn"] = new_turn()
        st["prompt"] = prompt[:300]
        if cfg["mode"] in BACKGROUND:
            st["judging"] = {"no": no, "at": time.time()}     # the end of the answer can wait for it
        widen, names = bool(WIDEN.search(prompt)), sorted(prompt_anchors(prompt))
        if cfg["mode"] in BACKGROUND:            # nothing is blocked: the new names count at once
            grow(st, names, widen)
        if widen:
            log(sdir, dict(base, decision="allow", type="ok", widened=True, reason="asked to go deeper"))
    job = {"sid": sid, "no": no, "prompt": prompt, "goal": goal, "done_when": done_when, "literal": literal,
           "names": names, "widen": widen}
    if cfg["mode"] in BACKGROUND:                  # decide in the background; never hold the prompt up
        try:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "judge", sdir, json.dumps(job)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError as e:
            log(sdir, dict(base, decision="allow", type="ok", reason="judge not started: " + str(e)[:200],
                           judge_error=True))
        return show(pending, cfg)
    rec = apply_verdict(sdir, job, cfg, *judge(job, cfg))
    if rec["decision"] == "block":
        return {"decision": "block", "reason": (
            "claude-guard: this looks like a new objective, not part of this session's goal ({}).\n"
            "Session goal: {}\nStart it in its own session (claude-new), re-anchor this one with "
            "claude-goal \"...\" if the goal really changed, or resend it starting with force: "
            "to go ahead here.").format(rec["reason"], goal)}
    if rec.get("literal"):
        return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": (
            "Scope of this request (claude-guard): {} Do exactly this. Where going further would help, "
            "end by proposing the next level instead of doing it.").format(rec["literal"])}}
    return None


def notices(sdir, sid, cfg):
    """Warnings waiting to be shown (warn mode): the judge runs after the prompt has gone, so its
    verdict is shown at the next chance -- a tool call, the end of the answer, or the next prompt."""
    if cfg["mode"] != "warn":
        return []
    with scope(sdir, sid) as st:
        return st.pop("notices", [])


def show(messages, cfg):
    """A hook answer that only shows the user a message -- in warn mode -- or nothing."""
    if cfg["mode"] != "warn":
        return None
    messages = [m for m in messages if m]
    return {"systemMessage": "\n".join(messages)} if messages else None


def new_turn():
    return {"reach": 0, "outside": [], "calls": {}}


def on_tool(payload, cfg):
    tool = payload.get("tool_name") or ""
    if tool not in WRITE_TOOLS and not REACH_TOOLS.match(tool):
        return None
    sdir = session_dir(payload.get("cwd"), cfg["root"])
    if not sdir:
        return None
    sid, tool_input, cwd = payload.get("session_id") or "none", payload.get("tool_input") or {}, payload.get("cwd")
    roots = safe_roots(sdir, payload)
    base = {"event": "tool", "session_id": sid, "initiated_by": "subagent" if payload.get("agent_id") else "agent",
            "mode": cfg["mode"], "tool": tool}
    if payload.get("agent_type"):
        base["agent_type"] = payload["agent_type"]
    pending = notices(sdir, sid, cfg)
    if tool in WRITE_TOOLS:
        learn(sdir, sid, resolve(tool_input.get(WRITE_TOOLS[tool]) or "", cwd), roots, base)
        return show(pending, cfg)
    key = hashlib.sha1((tool + json.dumps(tool_input, sort_keys=True)).encode()).hexdigest()[:12]
    goal = session_goal(sdir)[0]
    declared = declared_paths(sdir)
    with scope(sdir, sid) as st:
        turn = st.setdefault("turn", new_turn())
        turn["reach"] = turn.get("reach", 0) + 1
        calls = turn.setdefault("calls", {})
        calls[key] = calls.get(key, 0) + 1
        repeats = calls[key]
        targets = st.get("targets") or []
        area = {"paths": declared + (st.get("paths") or []),
                "words": set(st.get("words") or []) | set(WORDS.findall(goal.lower()))}
        idents = {i for i in reached(tool, tool_input, cfg["ignore"], cwd) if not safe(i, roots)}
        off = [] if st.get("open") else sorted(i for i in idents if outside(i, targets, area))
        new_off = [i for i in off if i not in turn.setdefault("outside", [])]
        turn["outside"] += new_off
        literal = st.get("literal") or ""
    base["prompt_no"] = st.get("prompt_no")
    if repeats >= LOOP_AFTER:                    # denied every time from then on, logged once
        if repeats == LOOP_AFTER:
            log(sdir, dict(base, decision="deny", type="loop", reason="same call {} times in one request".format(repeats)))
            pending.append("claude-guard: Claude ran the same {} call {} times in this request.".format(tool, repeats))
        return deny(cfg, "claude-guard: this is the same {} call {} times in this request. Change approach or ask "
                         "the user instead of repeating it.".format(tool, repeats), pending)
    if off:                                      # denied every time, logged once per identifier
        if new_off:
            log(sdir, dict(base, decision="deny", type="depth", reason="outside the request's scope",
                           reached=new_off[:5], targets=targets[:20]))
            pending.append("claude-guard: Claude is reading {}, outside this request.".format(", ".join(new_off[:3])))
        return deny(cfg, "claude-guard: out of scope. This request is: {} -- and {} is outside it (its folder, the "
                         "repos it works in, and what it names). Don't open it now; list it as a possible next "
                         "step.".format(literal or "(see the prompt)", ", ".join(off[:3])), pending)
    return show(pending, cfg)


def outside(ident, targets, area):
    """Is what a call reaches outside the request? A path is inside when it's under a declared or
    learned folder, in a git repo the goal or a prompt names, or on a target. Anything else --
    a table, a URL, a search -- can only be judged against targets, so with none it passes."""
    if ident.startswith("/"):
        low = os.path.realpath(ident).lower()
        if any(low == p or low.startswith(p + "/") for p in area["paths"]):
            return False
        repo = git_root(ident)
        if repo and os.path.basename(repo).lower() in area["words"]:
            return False
        return not (targets and matches(ident, targets))
    return bool(targets) and not matches(ident, targets)


def learn(sdir, sid, path, roots, base):
    """A write inside a git repo puts that repo in the session's scope: that's where the work is."""
    repo = git_root(path) if path else None
    if not repo or safe(repo, roots):
        return None
    low = os.path.realpath(repo).lower()
    with scope(sdir, sid) as st:
        paths = st.setdefault("paths", [])
        if low in paths:
            return None
        paths.append(low)
        base["prompt_no"] = st.get("prompt_no")
    log(sdir, dict(base, decision="allow", type="ok", learned=repo, reason="edits a file in this repo: now in scope"))
    return None


def await_verdict(sdir, sid):
    """Warn mode: the judge runs in the background and a short answer can finish first. Wait a
    little for this prompt's verdict, so its notice shows with the answer rather than a prompt
    later. Never for a judge that started too long ago (it may have died)."""
    deadline = time.time() + VERDICT_WAIT
    while True:
        with scope(sdir, sid) as st:
            judging = st.get("judging") or {}
            waiting = judging.get("no") == st.get("prompt_no") and time.time() - judging.get("at", 0) < VERDICT_STALE
        if not waiting or time.time() >= deadline:
            return
        time.sleep(0.25)


def deny(cfg, reason, pending=()):
    """Enforce: deny the call. Warn: show what enforce would have denied. Shadow: nothing."""
    if cfg["mode"] != "enforce":
        return show(pending, cfg)
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                   "permissionDecisionReason": reason}}


def on_stop(payload, cfg):
    sdir = session_dir(payload.get("cwd"), cfg["root"])
    if not sdir:
        return None
    sid = payload.get("session_id") or "none"
    if cfg["mode"] == "warn" and not payload.get("stop_hook_active"):
        await_verdict(sdir, sid)
    pending = notices(sdir, sid, cfg)
    with scope(sdir, sid) as st:
        asked = st.get("prompt") or ""
        turn = st.get("turn") or new_turn()
        no = st.get("prompt_no")
        if not payload.get("stop_hook_active"):
            st["turn"] = dict(turn, stopped=True)
    if turn.get("stopped") and not payload.get("stop_hook_active"):
        return show(pending, cfg)                       # nothing happened since the last stop
    text = payload.get("last_assistant_message") or ""
    # next steps are expected after a real investigation, unless the prompt asked for brevity
    investigated = (turn.get("reach", 0) >= INVESTIGATION or bool(turn.get("outside"))) and not BRIEF.search(asked)
    missing = investigated and not payload.get("stop_hook_active") and not (
        PROPOSALS.search(text[-800:]) or text.rstrip().endswith("?"))
    typ = "depth" if (turn.get("outside") or missing) else "ok"
    reasons = (["went outside the targets: " + ", ".join(turn["outside"][:5])] if turn.get("outside") else []) + \
              (["no next-level proposals at the end"] if missing else [])
    log(sdir, {"event": "stop", "session_id": sid, "prompt_no": no, "initiated_by": "agent", "mode": cfg["mode"],
               "decision": "block" if missing else "allow", "type": typ, "reason": "; ".join(reasons) or "ok",
               "reach": turn.get("reach", 0), "outside": len(turn.get("outside") or []),
               "retry": bool(payload.get("stop_hook_active"))})
    if missing and cfg["mode"] == "enforce":
        return {"decision": "block", "reason": (
            "claude-guard: before finishing, add a short closing list of what could be examined next "
            "(the next level of depth) and why -- as proposals, without doing it.")}
    if missing:
        pending.append("claude-guard: the answer ended without proposing what to look at next.")
    return show(pending, cfg)


# --- the report -----------------------------------------------------------------------------
def report(args, cfg, out):
    days, path = 14, cfg["root"]
    it = iter(args)
    for a in it:
        if a == "--days":
            days = int(next(it, "14"))
        else:
            path = os.path.realpath(a)
    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    recs = []
    for d, _, files in os.walk(path):
        if ".quality.jsonl" in files:
            with open(os.path.join(d, ".quality.jsonl")) as fh:
                for line in fh:
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(r, dict) and r.get("ts", "") >= since:
                        recs.append(dict(r, folder=os.path.relpath(d, cfg["root"])))
    out.write("claude-guard: last {} days, {} records, mode now {}\n".format(days, len(recs), cfg["mode"]))
    if not recs:
        return 0
    counts = {}
    for r in recs:
        k = (r.get("event"), r.get("type"), r.get("decision"))
        counts[k] = counts.get(k, 0) + 1
    out.write("\n  {:<8} {:<7} {:<8} {:>5}\n".format("event", "type", "decision", "n"))
    for k in sorted(counts, key=lambda k: tuple(x or "" for x in k)):
        out.write("  {:<8} {:<7} {:<8} {:>5}\n".format(*(x or "-" for x in k), counts[k]))
    ms = sorted(r["judge_ms"] for r in recs if isinstance(r.get("judge_ms"), int) and not r.get("judge_error"))
    errs = sum(1 for r in recs if r.get("judge_error"))
    if ms or errs:
        out.write("\n  judge: {} calls, median {:.1f}s, p90 {:.1f}s, {} failed\n".format(
            len(ms), ms[len(ms) // 2] / 1000 if ms else 0, ms[int(len(ms) * 0.9)] / 1000 if ms else 0, errs))
    done = reviews(cfg["root"])
    judged = {d["id"]: d for d in read_jsonl(os.path.join(journal_dir(cfg["root"]), "judge.jsonl"))
              if d.get("id") and d.get("ts", "") >= since}
    labels = [done[i] for i in judged if i in done]
    if labels:
        wrong = [l for l in labels if l.get("label") == "wrong"]
        out.write("  judge reviewed: {} of {}, {} right, {} wrong\n".format(
            len(labels), len(judged), len(labels) - len(wrong), len(wrong)))
        for l in wrong[-5:]:
            d = judged[l["id"]]
            out.write("    wrong {}: {} -> {}{}\n".format(l["id"], d.get("prompt", "")[:70], d.get("verdict"),
                                                        " (" + l["note"] + ")" if l.get("note") else ""))
    over = sum(1 for r in recs if r.get("override"))
    if over:
        out.write("  overrides (force:): {}\n".format(over))
    for typ, title in (("pivot", "Pivots"), ("depth", "Out of scope"), ("loop", "Loops")):
        rows = [r for r in recs if r.get("type") == typ][-8:]
        if rows:
            out.write("\n  {} (latest {}):\n".format(title, len(rows)))
            for r in rows:
                what = r.get("prompt") or ", ".join(r.get("reached") or []) or r.get("tool") or "(end of answer)"
                out.write("    {}  {}\n      {}\n      -> {}\n".format(r["ts"][:16], r["folder"], what[:110],
                                                                    (r.get("reason") or "")[:140]))
    return 0


# --- entry point ------------------------------------------------------------------------------
HOOKS = {"prompt": on_prompt, "tool": on_tool, "stop": on_stop}


def main(argv=None, stdin=None, stdout=None):
    argv = sys.argv[1:] if argv is None else argv
    stdin, stdout = stdin or sys.stdin, stdout or sys.stdout
    cmd = argv[0] if argv else ""
    cfg = settings(load_config())
    if cmd == "report":
        return report(argv[1:], cfg, stdout)
    if cmd == "review":
        return review(argv[1:], cfg, stdout)
    if cmd == "judge":                             # the background half of a shadow prompt check
        job = json.loads(argv[2])
        apply_verdict(argv[1], job, cfg, *judge(job, cfg))
        return 0
    if cmd not in HOOKS:
        print("usage: claude-guard prompt|tool|stop  (hooks, JSON on stdin)\n"
              "       claude-guard report [--days N] [PATH]\n"
              "       claude-guard review [--days N] [--all] | review ID right|wrong [NOTE]", file=sys.stderr)
        return 0 if cmd in ("-h", "--help") else 1
    if os.environ.get(JUDGE_ENV) or cfg["mode"] == "off":
        return 0
    try:
        payload = json.load(stdin)
        answer = HOOKS[cmd](payload, cfg) if isinstance(payload, dict) else None
    except Exception as e:                         # fail open, always
        print("claude-guard {}: {}: {}".format(cmd, type(e).__name__, e), file=sys.stderr)
        return 0
    if answer:
        stdout.write(json.dumps(answer))
    return 0


if __name__ == "__main__":
    sys.exit(main())
