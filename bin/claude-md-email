#!/usr/bin/env python3
"""claude-md-email: render a Markdown file for pasting into an email.

  claude-md-email FILE.md             copy it, formatted, to the clipboard
  claude-md-email FILE.md --open      open it as a web page instead
  claude-md-email FILE.md --html OUT  write the HTML to OUT ('-' for stdout)

pandoc renders it and yazi/md-email.css styles it: black on white, Calibri, bordered
tables, whatever the editor's theme. The styles are written onto each element, because
Outlook drops a <style> block on paste. The clipboard gets the HTML and, for plain-text
fields, the Markdown itself.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
CSS = os.path.join(HERE, "..", "yazi", "md-email.css")
# The page layout of the stylesheet's body rule has no place in a pasted fragment
FRAGMENT_DROP = {"margin", "max-width"}


def parse_css(text):
    """{tag: "prop: value; ..."} from simple `tag, tag { ... }` rules; later rules add to earlier."""
    text = re.sub(r"/\*.*?\*/", "", re.sub(r"</?style[^>]*>", "", text), flags=re.S)
    rules = {}
    for sels, body in re.findall(r"([^{}]+)\{([^}]*)\}", text):
        decls = "; ".join(d.strip() for d in body.split(";") if d.strip())
        for sel in (s.strip().lower() for s in sels.split(",")):
            if re.fullmatch(r"[a-z][a-z0-9]*", sel):
                rules[sel] = "; ".join(filter(None, [rules.get(sel, ""), decls]))
    return rules


def inline(html, rules):
    """Write each tag's rules into its style attribute (before any style it already has),
    and wrap the whole in a div carrying the body rule."""
    def repl(m):
        tag, attrs = m.group(1), m.group(2) or ""
        style = rules.get(tag.lower())
        if not style:
            return m.group(0)
        own = re.search(r'\sstyle="([^"]*)"', attrs)
        if own:
            attrs = attrs.replace(own.group(0), ' style="{}; {}"'.format(style, own.group(1)))
        else:
            attrs = ' style="{}"'.format(style) + attrs
        return "<{}{}>".format(tag, attrs)

    body = re.sub(r"<([a-zA-Z][a-zA-Z0-9]*)(\s[^<>]*?)?(/?)>",
                  lambda m: repl(m)[:-1] + m.group(3) + ">", html)
    base = "; ".join(d for d in rules.get("body", "").split("; ")
                     if d and d.split(":")[0].strip() not in FRAGMENT_DROP)
    return '<div style="{}">\n{}</div>\n'.format(base, body) if base else body


def render(md_path, css_path=CSS):
    """The file as email-ready HTML, from pandoc (GitHub-flavoured Markdown)."""
    if not shutil.which("pandoc"):
        raise SystemExit("claude-md-email: pandoc is not installed "
                         "(macOS: brew install pandoc; Linux: your package manager)")
    r = subprocess.run(["pandoc", md_path, "-f", "gfm", "-t", "html5"],
                       capture_output=True, text=True)
    if r.returncode:
        raise SystemExit("claude-md-email: pandoc failed: " + r.stderr.strip())
    with open(css_path) as fh:
        return inline(r.stdout, parse_css(fh.read()))


def system():
    if sys.platform == "darwin":
        return "mac"
    try:
        with open("/proc/version") as fh:
            return "wsl" if "microsoft" in fh.read().lower() else "linux"
    except OSError:
        return "linux"


MAC_COPY = """
ObjC.import('AppKit');
function run(argv) {
  const read = p => $.NSString.stringWithContentsOfFileEncodingError(p, $.NSUTF8StringEncoding, null);
  const pb = $.NSPasteboard.generalPasteboard;
  pb.clearContents;
  pb.setStringForType(read(argv[0]), $.NSPasteboardTypeHTML);
  pb.setStringForType(read(argv[1]), $.NSPasteboardTypeString);
}
"""

WSL_COPY = "Set-Clipboard -AsHtml -Value ([IO.File]::ReadAllText('{html}', [Text.Encoding]::UTF8))"


def copy(html, plain, osname=None):
    """Put HTML (and plain text) on the clipboard. Returns the tool used."""
    osname = osname or system()
    with tempfile.TemporaryDirectory() as tmp:
        hp, tp = os.path.join(tmp, "m.html"), os.path.join(tmp, "m.txt")
        with open(hp, "w", encoding="utf-8") as fh:
            fh.write(html)
        with open(tp, "w", encoding="utf-8") as fh:
            fh.write(plain)
        if osname == "mac":
            cmd = ["osascript", "-l", "JavaScript", "-e", MAC_COPY, hp, tp]
        elif osname == "wsl":
            # Windows PowerShell 5.1 has -AsHtml, which builds the clipboard's HTML Format header
            win = subprocess.run(["wslpath", "-w", hp], capture_output=True, text=True).stdout.strip()
            cmd = ["powershell.exe", "-NoProfile", "-Command", WSL_COPY.format(html=win.replace("'", "''"))]
        elif shutil.which("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
            cmd = ["wl-copy", "--type", "text/html"]
        elif shutil.which("xclip"):
            cmd = ["xclip", "-selection", "clipboard", "-t", "text/html"]
        else:
            raise SystemExit("claude-md-email: no clipboard tool (install wl-clipboard or xclip), "
                             "or use --open")
        stdin = html if cmd[0] in ("wl-copy", "xclip") else None
        r = subprocess.run(cmd, input=stdin, capture_output=True, text=True,
                           cwd="/mnt/c" if osname == "wsl" and os.path.isdir("/mnt/c") else None)
        if r.returncode:
            raise SystemExit("claude-md-email: copying failed: " + (r.stderr or r.stdout).strip())
    return cmd[0]


def page(html, title):
    return ('<!DOCTYPE html>\n<html><head><meta charset="utf-8"><title>{}</title></head>'
            '<body style="background: #fff">\n{}</body></html>\n').format(title, html)


def open_page(html, title, osname=None):
    osname = osname or system()
    out = os.path.join(tempfile.gettempdir(), "md-email")
    os.makedirs(out, exist_ok=True)
    path = os.path.join(out, title + ".html")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(page(html, title))
    if osname == "mac":
        cmd = ["open", path]
    elif osname == "wsl":
        cmd = ["wslview", path] if shutil.which("wslview") else ["explorer.exe", path]
    else:
        cmd = ["xdg-open", path]
    subprocess.run(cmd, capture_output=True)
    return path


def main(argv=None):
    ap = argparse.ArgumentParser(prog="claude-md-email", description=__doc__.split("\n\n")[0].split(": ", 1)[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("file", help="the Markdown file")
    what = ap.add_mutually_exclusive_group()
    what.add_argument("--open", action="store_true", help="open it as a web page instead of copying")
    what.add_argument("--html", metavar="OUT", help="write the HTML to OUT ('-' for stdout)")
    args = ap.parse_args(argv)
    if not os.path.isfile(args.file):
        raise SystemExit("claude-md-email: no such file: " + args.file)
    html = render(args.file)
    title = os.path.splitext(os.path.basename(args.file))[0]
    if args.html == "-":
        sys.stdout.write(html)
    elif args.html:
        with open(args.html, "w", encoding="utf-8") as fh:
            fh.write(page(html, title))
        print("wrote " + args.html)
    elif args.open:
        print("opened " + open_page(html, title))
    else:
        with open(args.file, encoding="utf-8") as fh:
            plain = fh.read()
        copy(html, plain)
        print("copied {} for email — paste it into Outlook".format(os.path.basename(args.file)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
